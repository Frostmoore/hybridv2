APP_NAME=HybridV2
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hybridandgogsv2.test

# Domini (prod: hybridandgogsv2.it / agencies.hybridandgogsv2.it)
APP_DOMAIN_MAIN=hybridandgogsv2.test
APP_DOMAIN_AGENCIES=agencies.hybridandgogsv2.test

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hybridv2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ─── API v2: JWT (HS256, compatibile col formato legacy) ───
# Secret NUOVO (mai riusare quello del server legacy). Min 64 caratteri casuali.
JWT_SECRET=
# Durata token in secondi (30 giorni)
JWT_EXPIRY=2592000

# ─── Pagina import polizze (sistema B, import_polizze) ───
IMPORT_PASSWORD=

# ─── Mail (prod: SMTP Aruba come il legacy) ───
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtps.aruba.it
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@seemypage.it"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
